{
  "name": "myblogs",
  "private": true,
  "scripts": {
    "install:all": "npm install",
    "build:auth-service": "nest build auth-service",
    "build:blog-service": "nest build blog-service",
    "build:media-service": "nest build media-service",
    "build:api-gateway": "nest build api-gateway",
    "build:frontend": "vite build --config frontend/vite.config.js",
    "build:all": "npm run build:auth-service && npm run build:blog-service && npm run build:media-service && npm run build:api-gateway && npm run build:frontend",
    "start:auth-service": "nest start auth-service --watch",
    "start:blog-service": "nest start blog-service --watch",
    "start:media-service": "nest start media-service --watch",
    "start:api-gateway": "nest start api-gateway --watch",
    "dev:frontend": "vite --config frontend/vite.config.js",
    "start": "dotenv -e .env -- concurrently \"npm run start:auth-service\" \"npm run start:blog-service\" \"npm run start:media-service\" \"npm run start:api-gateway\" \"npm run dev:frontend\"",
    "start:all": "npm start",
    "start:backend": "dotenv -e .env -- concurrently \"npm run start:auth-service\" \"npm run start:blog-service\" \"npm run start:media-service\" \"npm run start:api-gateway\"",
    "seed": "cd blog-service && ts-node src/seed.ts",
    "test:auth-service": "jest --config auth-service/jest.config.js",
    "test:blog-service": "jest --config blog-service/jest.config.js",
    "test:media-service": "jest --config media-service/jest.config.js",
    "test:api-gateway": "jest --config api-gateway/jest.config.js",
    "test:cov:auth-service": "jest --config auth-service/jest.config.js --coverage",
    "test:cov:blog-service": "jest --config blog-service/jest.config.js --coverage",
    "test:cov:media-service": "jest --config media-service/jest.config.js --coverage",
    "test:cov:api-gateway": "jest --config api-gateway/jest.config.js --coverage",
    "test:frontend": "vitest run --config frontend/vite.config.js",
    "test:cov:frontend": "vitest run --coverage --config frontend/vite.config.js",
    "sonar": "dotenv -e .env -- sh -c 'sonar-scanner -Dsonar.projectKey=\"$SONAR_PROJECT_KEY\" -Dsonar.scanner.socketTimeout=300 -Dsonar.scanner.responseTimeout=300'",
    "sonar:gate": "dotenv -e .env -- sh scripts/sonar-quality-gate.sh",
    "sonar:check": "npm run sonar && npm run sonar:gate",
    "codeql:gate": "sh scripts/codeql-quality-gate.sh",
    "coverage:python": "python3 -m pytest --cov=meridian_agents --cov-report=xml:coverage-python.xml --cov-report=term",
    "coverage:all": "npm run test:cov:auth-service && npm run test:cov:blog-service && npm run test:cov:media-service && npm run test:cov:api-gateway && npm run test:cov:frontend && npm run coverage:python",
    "sonar:full": "npm run coverage:all && npm run sonar:check"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/typeorm": "^11.0.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-blockquote": "^3.27.1",
    "@tiptap/extension-bold": "^3.27.1",
