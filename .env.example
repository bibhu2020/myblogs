# === Database ===

# PostgreSQL connection string (Neon or any Postgres-compatible provider)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# === AI / LLM providers ===

OPENAI_API_KEY=sk-proj-xxxxx

# Gemini API key — image generation fallback (get free key at aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here

# === Media & images ===

# GitHub personal access token — used by media-service to upload images to GitHub
# Requires repo scope (classic PAT)
SECRET_TOKEN_GITHUB=github_pat_xxxxx

# Unsplash API key — final image fallback (free at unsplash.com/developers, 50 req/hr)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here

# === Text-to-speech ===

# Hugging Face token — used for TTS (facebook/mms-tts-eng, faster than OpenAI).
# Falls back to OPENAI_API_KEY if not set. Same token used for HF Spaces deployment.
HF_TOKEN=hf_xxxxx

# Local/self-hosted TTS service URL — used instead of HF_TOKEN if set
TTS_SERVICE_URL=http://localhost:5050

# === Deployment (HF Spaces) ===

# Public URL of the deployed Hugging Face Space, used by GitHub Actions agent
# workflows as SERVER_BASE/MCP_URL — set as an Actions "variable", not a secret
HF_SPACE_URL=https://your-space.hf.space

# Base URL agents call to reach the deployed app (usually same as HF_SPACE_URL)
SERVER_BASE=https://your-space.hf.space

# === MCP server ===

# MCP server API key — agents must pass this in: Authorization: Bearer <key>
# Generate with: openssl rand -hex 24
MCP_API_KEY=mcp-your-secret-key-here

# === Web push notifications (VAPID) ===

VAPID_EMAIL=mailto:admin@example.com
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here

# === SonarQube (code quality scanning) ===

SONAR_HOST_URL=https://sonarqube.example.com
SONAR_TOKEN=sqp_xxxxx
SONAR_PROJECT_KEY=your-project-key

# === Unused / legacy (present in some environments, no current codebase usage) ===

GITHUB_TOKEN=github_pat_xxxxx
NEXTAUTH_SECRET=your-nextauth-secret-here
SALT=your-salt-here
ENCRYPTION_KEY=your-encryption-key-here
